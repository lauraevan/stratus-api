{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arcmail",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "vars": {
    "MAIL_DOMAIN": "mail.example.com"
  },
  "kv_namespaces": [
    {
      "binding": "MAILBOXES",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
